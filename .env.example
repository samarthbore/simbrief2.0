# Backend configuration
APP_NAME="Aviation Flight Planner"
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1
DATABASE_URL=sqlite:///./aviation_planner.db
# For PostgreSQL / PostGIS:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aviation_planner

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME="Aviation Flight Planner"
NEXT_PUBLIC_ENABLE_OFFLINE_GLOBE=true
